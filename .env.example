APP_NAME=Green
# These two are the safe values for a server. `composer setup` writes
# APP_ENV=local and APP_DEBUG=true instead, for development and the demo.
# Two-factor sign-in is required only when APP_ENV=production.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address you open Green at. When it starts with https://, the session
# cookie is only ever sent over HTTPS.
APP_URL=http://127.0.0.1:8000
# After rotating APP_KEY, list the old key here so stored bank tokens still decrypt.
# APP_PREVIOUS_KEYS=
# Reverse proxies in front of Green, if any: 127.0.0.1 for one on the same
# machine, several separated by commas. Without this, Green behind a proxy
# that handles HTTPS can't tell the request was secure.
TRUSTED_PROXIES=
# Your timezone (e.g. America/Chicago), so "today" and "overdue" match your day.
APP_TIMEZONE=UTC
# Shown on the public privacy page (/privacy) for questions and deletion requests.
PRIVACY_CONTACT_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# One log file a day, kept for 14 days.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=green
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email alerts through Resend: set MAIL_MAILER=resend and a verified MAIL_FROM_ADDRESS.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Plaid (https://dashboard.plaid.com/developers/keys)
# PLAID_ENV is "sandbox" or "production".
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_LANGUAGE=en
PLAID_DAYS_REQUESTED=90
# Required in production for OAuth banks (Chase, Capital One, ...). Must be HTTPS
# and registered in the Plaid dashboard, e.g. https://green.example.com/plaid/oauth
PLAID_REDIRECT_URI=
